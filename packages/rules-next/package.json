{
  "name": "@adysre/rules-next",
  "version": "0.1.0",
  "type": "module",
  "description": "Rules over HTTP: route handlers and server actions on the Web standard, so they run in Next.js and anywhere else.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhisheksahu093/Adysre.git",
    "directory": "packages/rules-next"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../config/scripts/fix-declarations.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "prepublishOnly": "node ../config/scripts/guard-publisher.mjs && pnpm build && node ../config/scripts/verify-dist.mjs"
  },
  "devDependencies": {
    "@adysre/config": "workspace:*",
    "@types/node": "^24.13.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@adysre/rules-core": "workspace:*",
    "@adysre/rules-storage": "workspace:*",
    "@adysre/rules-types": "workspace:*"
  },
  "keywords": [
    "rules-engine",
    "business-rules",
    "rule-builder",
    "json-logic",
    "decision-engine",
    "typescript"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
