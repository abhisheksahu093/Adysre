{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", "tsconfig.base.json"],
  /*
   * Turbo runs tasks in a filtered environment: a variable set on the hosting
   * platform and not listed here is NOT passed through, and the build sees it
   * as unset. Vercel warns about exactly this, naming the variables it is
   * about to withhold.
   *
   * `NODE_VERSION` is Vercel's own. The two database URLs are listed because
   * `prisma generate` reads the datasource block, and a build that silently
   * runs without them is the kind that succeeds locally and produces a broken
   * deployment.
   */
  "globalEnv": ["NODE_ENV", "NODE_VERSION", "DATABASE_URL", "DIRECT_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "adysre#build": {
      /*
       * The icon components and the blocks barrel are generated from the
       * catalogues, so a change to either has to re-run the build even though
       * nothing under `src/icons/generated` was edited by hand.
       */
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**", "src/icons/generated/**", "src/blocks/index.ts"]
    },
    "gen:icons": { "cache": false },
    "gen:blocks": { "cache": false },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "db:generate": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
