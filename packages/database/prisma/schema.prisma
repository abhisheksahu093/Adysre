  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [tenantId], references: [id])
  folder       QrFolder?    @relation(fields: [folderId], references: [id])
  scans        QrScan[]

  @@index([tenantId, deletedAt, updatedAt])
  @@index([tenantId, folderId])
  @@map("qr_codes")
}

// Append-only scan events. No soft-delete/audit columns by design: a scan is an
// immutable fact, not an editable record (mirrors an audit log).
model QrScan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  qrCodeId  String   @map("qr_code_id") @db.Uuid
  /// Coarse device class parsed from the User-Agent (mobile/tablet/desktop).
  device    String?
  browser   String?
  os        String?
  /// Referrer host, when the scanner sent one.
  referrer  String?
  /// Best-effort region from Accept-Language (no external geo-IP service).
  country   String?
  city      String?
  /// UTM parameters captured off the scan URL.
  utm       Json?
  scannedAt DateTime @default(now()) @map("scanned_at")

  qrCode QrCode @relation(fields: [qrCodeId], references: [id])

  @@index([qrCodeId, scannedAt])
  @@index([tenantId, scannedAt])
  @@map("qr_scans")
}

