/// An immutable snapshot of a resume, captured on save/export.
model ResumeVersion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  resumeId  String   @map("resume_id") @db.Uuid
  /// Monotonic version number within the resume.
  version   Int
  /// The ResumeData snapshot at this version.
