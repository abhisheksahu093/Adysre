  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [tenantId], references: [id])
  qrCodes      QrCode[]

  @@index([tenantId, deletedAt])
  @@map("qr_folders")
}

model QrCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  /// Short, public, URL-safe code the dynamic QR encodes: /q/<slug>.
  slug      String    @unique
  /// Registry type id (url, wifi, vcard, …). See lib/tools/qr/registry.
  type      String
  /// Human label shown in the saved-codes list.
  name      String
  /// The type's field values, as entered.
  payload   Json
  /// The QrDesign (colors, styles, logo reference).
