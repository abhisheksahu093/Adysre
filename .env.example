# ---- App ----
NODE_ENV=development

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- API (apps/api) ----
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
# Public base URLs used to build OAuth redirect URIs and the post-login bounce.
# API_PUBLIC_URL must be reachable by the browser and match the callback URL
# registered in each provider's console.
API_PUBLIC_URL=http://localhost:4000
APP_URL=http://localhost:3000

# ---- Database ----
#
# Two URLs, because Prisma needs both when anything sits in front of Postgres.
#
#   DATABASE_URL  the POOLED connection, used at runtime. Serverless functions
#                 scale to many short-lived instances and each one opening its
#                 own connection exhausts the server's limit, which shows up as
#                 "too many connections" under load and never locally.
#   DIRECT_URL    the DIRECT connection, used only by `prisma migrate` and
#                 introspection. A pooler multiplexes sessions and a migration
#                 needs a real one: advisory locks and DDL do not survive being
#                 handed a different backend mid statement.
#
# Locally there is no pooler, so both point at the same database.
DATABASE_URL="postgresql://adysre:adysre@localhost:5432/adysre?schema=public"
DIRECT_URL="postgresql://adysre:adysre@localhost:5432/adysre?schema=public"
#
# ── Production ──────────────────────────────────────────────────────────────
# Never commit real credentials. Set these in the hosting platform's dashboard
# and take the values from whichever provider you actually use:
#
#   Vercel Postgres / Neon integration - Vercel injects these already, so map:
#     DATABASE_URL = $POSTGRES_PRISMA_URL          (pooled, ?pgbouncer=true)
#     DIRECT_URL   = $POSTGRES_URL_NON_POOLING     (direct)
#
#   Neon, set by hand - the pooled host carries `-pooler`, the direct one does not:
#     DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#     DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
#
#   Supabase - the pooler is port 6543, the direct connection 5432:
#     DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#     DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Generate each with `openssl rand -base64 48`. They must differ from each other
# and per environment: reusing a staging secret means a staging token
# authenticates in production. The `change-me` values below are REJECTED at
# runtime, deliberately, so a deployment cannot boot with no trust model.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# bcrypt cost factor. 12 is roughly 250ms, and the slowness is the point:
# whatever a user waits once at sign-in, an attacker waits per guess. Values
# under 10 are refused, and over 15 sign-in exceeds the serverless timeout.
BCRYPT_COST=12

# Shared secret for the scheduled caller that deletes expired sessions, reset
# and verification tokens, and rate-limit windows. Sent as
# `Authorization: Bearer <secret>` or `x-cron-secret`. UNSET MEANS NOBODY CAN
# RUN IT, which is the correct default for an endpoint that deletes rows.
# Generate with: openssl rand -base64 32
AUTH_CLEANUP_SECRET=

# Extra origins allowed to make state-changing requests, comma separated.
# NEXT_PUBLIC_APP_URL is always allowed. Leave blank unless another origin
# genuinely needs to post here.
ALLOWED_ORIGINS=

# Leave EMPTY for the web app. An unset domain yields a host-only cookie; a
# cookie scoped to `.example.com` is readable by every subdomain, so one
# forgotten subdomain reads production sessions. Only apps/api needs this, and
# only because it serves a different origin.
COOKIE_DOMAIN=

# ---- OAuth (Google / Microsoft / GitHub) ----
# Leave a pair blank to disable that provider - its button is auto-disabled.
# Callback URL to register with each provider (from API_PUBLIC_URL):
#   {API_PUBLIC_URL}/api/v1/auth/oauth/{google|microsoft|github}/callback
# See documents/OAUTH_SETUP.md for step-by-step setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Website Intelligence ----
#
# Until sign-in is live in the web app, a production deployment hands each
# anonymous visitor their OWN demo sandbox (a per-browser tenant) so the module
# is usable instead of bouncing everybody to a login form that cannot succeed.
# Set this to `true` the moment real sessions work - it restores the strict gate
# in every environment: no verified `access_token`, no access.
# Sign-in now works, so `true` is the right value. `API_STUDIO_STRICT_AUTH` does
# the same for API Studio. Both are inert under NODE_ENV=production regardless.
WEBSITE_INTEL_STRICT_AUTH=true
API_STUDIO_STRICT_AUTH=true
#
# Where scans, schedules and channels live: unset/`memory` (process-local) or
# `file` (paths below). Memory is ephemeral on serverless, which is the point in
# a demo and not enough for a real tenant.
WEBSITE_INTEL_STORE=
WEBSITE_INTEL_STORE_PATH=
WEBSITE_INTEL_SCHEDULE_PATH=
WEBSITE_INTEL_CHANNELS_PATH=
#
# Shared secret for the machine caller that sweeps due schedules
# (`Authorization: Bearer <secret>` or `x-cron-secret`). Unset means no machine
# caller can run the sweep at all.
WEBSITE_INTEL_CRON_SECRET=

# ---- Email ----
#
# Transactional mail: password reset and address confirmation links.
#
# With nothing set, development prints the whole message (LINKS INCLUDED) to the
# server log, which is why that transport is refused in production: a live
# reset link is an account takeover, and it would land in every log aggregator
# that ingests stdout.
#
# Production needs both of these, or links are never delivered and the reset
# flow cannot complete. The failure is logged loudly and never breaks the
# request that triggered it.
RESEND_API_KEY=
# Must be a verified sender on your provider, e.g. "ADYSRE <no-reply@yourdomain.com>"
EMAIL_FROM=
# Force a specific transport: `console` (development only). Leave blank to
# choose automatically.
EMAIL_TRANSPORT=

# Product name used in subjects and signatures. Defaults to ADYSRE.
NEXT_PUBLIC_APP_NAME=

# ---- AI ----
ANTHROPIC_API_KEY=
