{
  "name": "@adysre/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-template-sources.mjs && next dev -p 3000",
    "build": "node scripts/generate-template-sources.mjs && next build",
    "start": "next start -p 3000",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/generate-template-sources.mjs && tsx --test 'src/**/*.test.ts' && pnpm test:db",
    "postinstall": "node scripts/generate-template-sources.mjs",
    "gen:openapi": "tsx scripts/generate-openapi.mjs",
    "gen:section-demos": "node scripts/generate-section-demos.mjs",
    "gen:template-sources": "node scripts/generate-template-sources.mjs",
    "test:db": "tsx --conditions=react-server --test 'src/**/*.dbtest.ts'"
  },
  "dependencies": {
    "@adysre/database": "workspace:^",
    "@adysre/rules-core": "workspace:*",
    "@adysre/rules-devtools": "workspace:*",
    "@adysre/rules-next": "workspace:*",
    "@adysre/rules-parser": "workspace:*",
    "@adysre/rules-playground": "workspace:*",
    "@adysre/rules-react": "workspace:*",
    "@adysre/rules-renderer": "workspace:*",
    "@adysre/rules-storage": "workspace:*",
    "@adysre/rules-theme": "workspace:*",
    "@adysre/rules-types": "workspace:*",
    "@adysre/rules-ui": "workspace:*",
    "@adysre/sdk": "workspace:*",
    "@adysre/theme": "workspace:*",
    "@adysre/types": "workspace:*",
    "@adysre/validators": "workspace:*",
    "@anthropic-ai/sdk": "^0.112.4",
    "@hookform/resolvers": "^3.9.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@tanstack/react-query": "^5.59.0",
    "adysre": "workspace:*",
    "animejs": "^4.5.0",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.2.4",
    "framer-motion": "^12.42.2",
    "html-to-image": "^1.11.13",
    "jose": "^5.9.6",
    "jsbarcode": "^3.11.6",
    "konva": "^10.3.0",
    "lenis": "^1.3.25",
    "lucide-react": "^0.451.0",
    "mammoth": "^1.9.0",
    "next": "^16.0.0",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^4.10.38",
    "qr-code-styling": "^1.9.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "react-konva": "^19.2.5",
    "server-only": "^0.0.1",
    "shiki": "^4.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@adysre/config": "workspace:*",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.16.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "openapi3-ts": "^4.6.0",
    "tailwindcss": "^4.0.0",
