{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "noEmit": false,
    /*
     * The counterpart to `allowImportingTsExtensions`: emit is only allowed
     * alongside it when the extensions are rewritten, which is also what makes
     * the published files spec-compliant ESM.
     */
    "rewriteRelativeImportExtensions": true
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
