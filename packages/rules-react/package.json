{
  "name": "@adysre/rules-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless state for a rule builder: an immutable store with history, plus the React bindings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhisheksahu093/Adysre.git",
    "directory": "packages/rules-react"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@adysre/config": "workspace:*",
    "@types/node": "^20.16.10",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@adysre/rules-core": "workspace:*",
    "@adysre/rules-types": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
